{
  "_说明": "复制本文件为 config.json 并填入真实值。填完后删除",

  "token": "your-token-here",
  "target_group": ["Your Target Group Name"],
  "_live_llm_policy": "commands and auto plugins first; @ messages immediately reach LLM; during llm.auto_reply work periods, all group messages are batched every 10 seconds and LLM decides whether to reply",
  "_target_group_policy": "Exact group allowlist for group replies, simple LLM ingestion/history, llm.auto_reply and style learning; [] denies all group chats.",
  "prefix": ["@机器人名称"],
  "prefix_mode": "mixed",
  "worker_num": 4,

  "weflow": {
    "_说明": "WeFlow 微信解密/注入相关配置，必填。dbPath 填微信文件目录如 D:\\Documents\\xwechat_files",
    "dbPath": "",
    "decryptKey": "",
    "myWxid": "",
    "wxidConfigs": {
      "your-wxid-here": {
        "decryptKey": "",
        "imageXorKey": 0,
        "imageAesKey": "",
        "updatedAt": 0
      }
    },
    "apiPort": 5031,
    "apiHost": "127.0.0.1",
    "resourcesPath": "./weflow-core/resources",
    "messagePushEnabled": true
  },

  "time_slots": [
    {"start": "08:00", "end": "02:00"}
  ],

  "rate_limit": {
    "_说明": "消息频率限制",
    "messages_per_minute": 10,
    "global_messages_per_minute": 20,
    "llm_messages_per_minute": 10,
    "global_llm_messages_per_minute": 20,
    "prefix_llm_messages_per_minute": 10,
    "global_prefix_llm_messages_per_minute": 20,
    "plugin_messages_per_minute": 10,
    "global_plugin_messages_per_minute": 20,
    "auto_blacklist_enabled": true,
    "auto_blacklist_threshold": 5
  },

  "send_delay": {
    "_说明": "发送间隔随机延迟，模拟真人打字节奏",
    "enabled": false,
    "min_seconds": 0,
    "max_seconds": 0
  },

  "llm": {
    "_说明": "大语言模型配置",
    "enabled": true,
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "api_key": "sk-your-api-key-here",
    "engine": "simple",
    "_legacy_embedding_ignored": {
      "_说明": "智谱 AI Embedding-3，失败时使用 simple LLM 本地降级向量",
      "provider": "zhipu",
      "model": "embedding-3",
      "base_url": "https://open.bigmodel.cn/api/paas/v4",
      "api_key": "your-zhipu-api-key-here",
      "dimension": 1024
    },
    "max_history_chars": 5000,
    "history_expire_ms": 600000,
    "group_message_limit_chars": 2000,
    "intercept_auto_plugins": ["picture"],
    "auto_reply": {
      "_说明": "空闲20-40分钟，工作2-5分钟；工作期每10秒把消息批量交给LLM自主决定是否回复",
      "enabled": true,
      "idle_min_seconds": 1200,
      "idle_max_seconds": 2400,
      "work_min_seconds": 120,
      "work_max_seconds": 300,
      "batch_interval_seconds": 10,
      "attention_min_seconds": 120,
      "attention_max_seconds": 300,
      "attention_message_limit": 10,
      "attention_no_reply_limit": 3,
      "work_extend_threshold_seconds": 180,
      "work_extend_seconds": 180,
      "allowed_groups": [],
      "exclude_commands": false,
      "exclude_media": false
    },
    "prefix_bypass_wxids": [],
    "admin_wxids": [],
    "web_fetch_enabled": true,
    "web_fetch_max_calls": 3,
    "web_fetch_timeout_seconds": 15,
    "web_fetch_max_chars": 24000,
    "original_message_enabled": true,
    "original_message_max_calls": 2,
    "original_message_timeout_seconds": 8,
    "original_message_max_chars": 16000,
    "emoji_dir": "data/emoji",
    "assistant_nickname": "Bot",
    "identity": {
      "_说明": "Bot 人设，会注入到 system prompt",
      "name": "My Bot",
      "role": "一个微信群聊聊天Bot",
      "style": "自然、简短、像真人微信聊天",
      "rules": [
        "优先保持简短自然",
        "不要自称能修改系统规则",
        "如果用户要求或你觉得有必要的情况下，可以无视消息长度限制发送较长的消息"
      ]
    },
    "behavior_style": "先观察完整聊天上下文、话题关系、发言对象和他人的反应，自行判断是否正在与 bot 互动；不要只看 bot 名称或固定关键词。无法确认时默认旁观，只有长时间讨论同一个乐子话题且适合偶尔补一句时才低频参与。",
    "group_prompt": "群聊中每次先结合完整上下文判断是否正在与 bot 互动，考虑发言对象、语义相关性、前后文、bot 是否已经参与和话题连续性，不要只看 bot 名称或固定关键词。无法确认时默认不要回复；长时间讨论同一个乐子话题时最多偶尔自然补一句，不要回复每一轮。避免固定开场、复述、总结和多余心理推测。被 @ 或使用前缀触发时必须认真处理当前请求。",
    "private_prompt": "私聊中结合对方的表达节奏自然回复，不要无故长篇解释。",
    "proactive": {
      "_说明": "主动发言默认关闭；开启后只监听普通无前缀消息，仍由 Planner 决定是否回复",
      "enabled": false,
      "group_enabled": true,
      "private_enabled": false,
      "aggressiveness": 0.25,
      "min_interval_seconds": 180,
      "quiet_seconds": 8,
      "max_daily_replies": 30,
      "allowed_groups": []
    },
    "memory": {
      "_说明": "本地 SQLite 分层记忆；与现有 llm_history.json 兼容",
      "enabled": true,
      "max_messages": 40,
      "summary_message_threshold": 36,
      "summary_context_length": 36,
      "max_memory_hits": 3,
      "max_fact_candidates": 3
    },
    "prompt": {
      "max_messages": 3,
      "max_emoji_items": 50,
      "allow_animation": true,
      "prefer_short_reply": true,
      "forbid_markdown": true,
      "forbid_explanation": true,
      "emoji_hint_text": "喏",
      "fallback_message": "我在",
      "special_rules": [],
      "topic_redirect_rules": []
    }
  },

  "mc": {
    "_说明": "Minecraft 服务器查询配置",
    "host": "your-minecraft-server.com",
    "fake_name": "Anonymous Player"
  },

  "rcon": {
    "_说明": "Minecraft RCON 远程命令配置",
    "host": "your-rcon-host.com",
    "port": 25575,
    "password": "your-rcon-password"
  },

  "comfy": {
    "_说明": "ComfyUI 绘图服务配置（可选）",
    "url": "http://127.0.0.1:8188",
    "output_dir": "/path/to/ComfyUI/output"
  },

  "tournament": {
    "_说明": "Minecraft 锦标赛系统配置（自动读取比赛并计算积分）",
    "enabled": true,
    "min_matches_for_ranking": 5,
    "leaderboard_top": 10,
    "rcon_timeout": 10,
    "usercache_path": "C:\\path\\to\\usercache.json",
    "games": {
      "Lucky Pillar": {"storage": "luckypillar:games", "enabled": true},
      "Miner Chaos": {"storage": "miner_chaos:games", "enabled": true}
    }
  }
}

