{
  "token": "your-weflow-token",
  "target_group": [
    "Your Target Group Name"
  ],
  "prefix": [
    "@bot"
  ],
  "prefix_mode": "strict",
  "worker_num": 2,
  "weflow": {
    "dbPath": "D:\\Documents\\xwechat_files",
    "decryptKey": "your-64-character-wechat-decrypt-key",
    "myWxid": "your-wxid",
    "wxidConfigs": {},
    "apiHost": "127.0.0.1",
    "apiPort": 5031,
    "resourcesPath": "./weflow-core/resources",
    "messagePushEnabled": true
  },
  "time_slots": [],
  "rate_limit": {
    "messages_per_minute": 10,
    "global_messages_per_minute": 20,
    "llm_messages_per_minute": 10,
    "global_llm_messages_per_minute": 20,
    "prefix_llm_messages_per_minute": 10,
    "global_prefix_llm_messages_per_minute": 20,
    "plugin_messages_per_minute": 10,
    "global_plugin_messages_per_minute": 20,
    "auto_blacklist_enabled": false,
    "auto_blacklist_threshold": 5
  },
  "llm": {
    "enabled": true,
    "history_expire_ms": 600000,
    "apis": [
      {
        "name": "primary",
        "protocol": "responses",
        "model": "your-model-name",
        "api_key": "your-api-key",
        "base_url": "https://api.example.com/v1",
        "timeout_seconds": 60,
        "cache": true,
        "cache_scope": "full",
        "responses_explicit_cache_breakpoint": false,
        "priority": 1
      }
    ],
    "identity": {
      "name": "Bot",
      "role": "WeChat group assistant",
      "style": "Natural, concise, and context-aware",
      "rules": []
    },
    "memory": {
      "enabled": true
    },
    "learning": {
      "enabled": true,
      "bot_names": [],
      "expression_prompt_max_items": 3,
      "expression_selector_enabled": false,
      "idle_content_shadow_mode": true,
      "idle_content_cache_max_age_seconds": 43200,
      "idle_content_prefetch_min_interval_seconds": 1800,
      "idle_content_prefetch_min_items": 6
    },
    "auto_reply": {
      "enabled": false,
      "reply_trigger_mode": "conversation_pulse",
      "idle_min_seconds": 600,
      "idle_max_seconds": 1800,
      "conversation_lease_seconds": 90,
      "conversation_lease_direct_seconds": 180,
      "adaptive_idle_content_enabled": false
    }
  }
}
