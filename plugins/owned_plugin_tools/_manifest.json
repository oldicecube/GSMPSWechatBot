{
  "manifest_version": 2,
  "id": "wechatbot.owned-plugin-tools",
  "name": "自有插件 Agent Tools",
  "description": "List and invoke MaiBot-native plugin tools and ordinary-user commands once per reasoning turn; GSMPS shell plugins are excluded.",
  "version": "1.0.0",
  "author": {
    "name": "GSMPS Wechatbot",
    "url": "https://github.com/oldicecube"
  },
  "urls": {
    "repository": "https://github.com/oldicecube/GSMPSWechatBot"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.3.15",
    "max_version": "1.9.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "wechatbot.owned_plugins"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
