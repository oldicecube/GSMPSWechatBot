{
  "manifest_version": 2,
  "id": "wechatbot.scheduled-reminder",
  "name": "持久化定时提醒",
  "description": "迁移旧 Agent Tool 的当前请求者定时提醒：创建、查询、取消，到期唤醒 MaiBot。",
  "version": "1.0.0",
  "author": {"name": "Wechat Bot", "url": "https://github.com/oldicecube"},
  "urls": {"repository": "https://github.com/oldicecube/GSMPSWechatBot"},
  "license": "MIT",
  "host_application": {"min_version": "1.3.15", "max_version": "1.9.99"},
  "sdk": {"min_version": "2.16.0", "max_version": "2.99.99"},
  "dependencies": [],
  "capabilities": ["message.get_by_id", "chat.open_session", "maisaka.proactive.trigger"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
