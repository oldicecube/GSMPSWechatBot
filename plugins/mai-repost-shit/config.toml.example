# ============================================================================
# B站搬史机（mai repost shit）示例配置
# 复制成 config.toml 后按需修改；也可以直接启动，宿主会用同样的默认值自动生成。
# 判据只有一条：评论区艾特率。
# ============================================================================

[plugin]
# 插件总开关：装好后默认关闭，确认群号填对了再打开
enabled = false
# 配置版本（插件自己维护，一般不用动）
config_version = "1.2.2"

[target]
# 投递目标列表：填【群号】或【QQ 号】（填 QQ 号就是发给那个人私聊），不是 session_id；空串会被忽略。
# 注意：目标必须真实存在——群号写错、或该群/该人从没产生过消息，定时轮会跳过它
# （装载时会打日志告警）。
groups = []
# 每天搬几次（时刻在下面的时间段内随机分布）
daily_times = 3
# 允许发送的时间范围 [起, 止]，24 小时制
active_hours = [9, 23]
# 错过计划时刻后多久内仍补发（分钟）；超时直接跳过，避免重启后一次补发好几条
catch_up_minutes = 30
# 聊天记录里视频上方是否带说明（标题 / UP / 播放 / 艾特率 / 链接）
include_header_text = true

[source]
# 关键词池：每轮随机抽几个去搜。屎不挑分区，靠词覆盖 + 艾特率筛。
# 实测（2026-10-11，各 6 条样本）：泛鬼畜词（鬼畜/抽象/整活/答辩/难绷/绷不住）候选艾特率
# 中位 12%、最高 47%；泛搞笑词（沙雕/搞笑/名场面/迷惑行为/吐槽/社死/破防/离谱）中位 9%、最高 32%。
# 所以池子以泛鬼畜词为主——这是关键词，不是分区过滤。
keywords = ["鬼畜", "抽象", "整活", "答辩", "难绷", "绷不住", "逆天", "离谱", "沙雕"]
# 每轮用几个关键词去搜（越多候选越多，请求也越多）
keywords_per_run = 8
# 搜索排序，每轮随机选一个：totalrank = 综合排序、pubdate = 按发布时间。
# 不要用 click：它只给爆款，在 5万~30万 这个播放区间命中率实测为 0。
orders = ["totalrank", "pubdate"]
# 每个关键词随机翻到第几页（上限）
page_max = 3
# 发布时间窗 [最近, 最远]（小时）：默认 3 天前 ~ 30 天前发布
window_hours = [72, 720]
# 播放量区间（太低没评论、太高没屎味）
play_min = 50000
play_max = 300000
# 评论数下限：搜索接口自带该字段，先卡掉分母不够的视频（艾特率要有足够样本才算数）
min_video_review = 40
# 评论数上限（0 = 不限）：实测评论越多艾特率越低——40~150 条中位 33%、600+ 只 10%，
# 所以把解说/剧集类大热门筛掉。嫌候选少可以调大或设 0。
max_video_review = 600
# 每轮最多实际检查几条候选（每条约 4 个请求）。能过 50% 艾特率的候选约占一成，
# 检查越多越容易出片（今天 4 轮 36 条全没过的直接原因之一就是挑错了候选）
max_check_per_run = 16

[judge]
# 唯一判据：采到的评论里含 @ 的比例达到这个值才算"史"
at_ratio_threshold = 0.5
# 评论样本下限：不足这个数一律判"样本不足"（分母太小，比值是噪声）
min_comments = 30
# 每个候选取几页评论（每页 20 条）；实测取 3 页与取 6 页的通过数相同
comment_pages = 3

[download]
# 时长上限（秒）：超过就跳过，避免搬来几十分钟的合集
max_duration_seconds = 240
# 体积上限（MB）：超限会自动降一档清晰度（720P→480P→360P），不再直接丢弃候选。
# ⚠ 别调太大：实测 37MB 的视频，三条投递路线都被 NapCat 判定为失败
# （合并转发 / 直接发视频 / 按文件发全挂），所以默认只给 15MB。
max_size_mb = 10
# 清晰度优先级：64=720P, 32=480P, 16=360P。
# 免登录最高只给到 720P，所以"压到 720p"就是选档下载，不需要 ffmpeg 转码。
quality_preference = [64, 32, 16]
# 本地保留最近几个视频文件（其余在发送成功后清理）
# 视频内联发送的体积上限（MB）：不超过就带 base64 发，后端读不到本地文件也能发。
# 实测 SnowLuma 后端跑在别的文件系统上，给它本地路径会 EACCES 权限错误；
# 上限受插件↔宿主 RPC 帧 16MB 约束（base64 膨胀 4/3），所以别超过 11。
inline_video_max_mb = 10
keep_files = 2

[filters]
# 标题屏蔽词（子串匹配，命中即跳过）。默认挡的是长剧集 / 直播切片 / 剧透这类
# 容易混进来的内容；不想要就把列表清空。
title_blacklist = ["原神", "崩坏", "星穹铁道", "剧透", "直播回放", "录播", "合集"]
# 标签屏蔽词（搜索接口返回的 tag 字段，子串匹配）
tag_blacklist = []
# UP 主屏蔽词（子串匹配）
up_blacklist = []

[tool]
# 是否允许群友用自然语言叫它搬史（LLM 工具 repost_shi）
enabled = true
# 谁能触发：anyone = 群里任何人都可以（默认）、whitelist = 只有 whitelist 里的 QQ 能触发。
# 注意：工具回调拿不到点播者的 QQ，白名单是靠入站钩子按会话回查"最近发言者"实现的，
# 同一群多人抢话时可能错位，所以白名单模式下认不出发言者会直接拒绝。
permission = "anyone"
# permission = "whitelist" 时允许触发的 QQ 号列表
whitelist = []
# 发言者缓存有效期（秒）：超时后白名单模式会拒绝，需要对方重新发言
speaker_cache_ttl_seconds = 600
# 同一个群两次点播的最小间隔（分钟）
min_gap_seconds = 60
# 每个群每天点播的次数上限（0 表示不限）
# 单次点播最多搬几条
max_count = 3
# 点播后是否吞掉机器人这次的回话：只让工具把视频发出去，群里不多一句话。
# 实现方式是把这次回复的文本置空（宿主遇到空回复就不发送），只吞点播后的第一条。
suppress_reply = true
# 吞回话的有效窗口（秒）
suppress_reply_window_seconds = 120

[pretty]
# 「来点好看的」频道：只搬二次元、时长不长、收藏率高的视频。
# 触发语：来点涩的 / 来点色的 / 来点黄的 / 来点好看的 / 来点好康的
enabled = true
# 关键词池：按用户口径只收三类——MMD/3D 纸片人舞蹈、动漫剪辑 MAD/AMV、手书/同人动画。
keywords = ["MMD", "手书", "同人动画", "MAD", "AMV", "动漫混剪", "踩点剪辑", "纸片人", "虚拟主播", "二创"]
keywords_per_run = 6
orders = ["totalrank", "pubdate"]
page_max = 3
# 发布时间窗 [最近, 最远]（小时）
window_hours = [72, 720]
play_min = 10000
play_max = 500000
# 时长上限（秒）：这就是"时长不长"的闸门，默认 2 分钟
max_duration_seconds = 120
# 收藏率用哪个分母：fav_like = 收藏/点赞（默认）、fav_play = 收藏/播放。
# 为什么默认用点赞当分母：实测 73 条二次元短候选里，收藏/播放最高只到 40%、
# 一条都到不了 50%（收藏不可能比播放多一半）；而收藏/点赞中位就有 52%、≥50% 的有 39 条。
favorite_rate_metric = "fav_like"
# 收藏率下限。按 fav_like 口径实测：≥50% 留 39/73，≥80% 留 23，≥100%（收藏比点赞还多）留 13。
min_favorite_rate = 0.5
# 子分区白名单（子串匹配）：搜索接口给的是**子分区**；插画·绘画（静态图）与壁纸类已去掉。
# 实测能干净区分二次元与真人——
# 二次元落在 MMD·3D / 同人·手书 / MAD·AMV / 人力VOCALOID / 绘画 / 动画综合，
# 真人向落在 仿妆cos / 颜值·网红舞 / 舞蹈综合 / 特摄。想收宅舞之类的真人出镜内容，
# 把对应的子分区名加进来即可（如 "宅舞"）。
typename_whitelist = ["MMD", "手书", "MAD", "AMV", "VOCALOID", "动画", "同人", "虚拟"]
# 真人向屏蔽词：标题或标签命中即跳过（白名单之外的兜底）
real_blacklist = ["真人", "cos", "仿妆", "颜值", "网红", "模特", "街拍", "vlog", "探店", "旅拍", "素人"]
# 教程/讲解类屏蔽词：标题或标签命中就跳过。
# 「来点好看的」要的是好看的画面，不是教学——实测搬回来过
# 「【思路分享】怎么去丰富手书」（分区没问题、收藏率 23.6%，但内容是个教程）。
block_words = ["教程", "教学", "教你", "手把手", "零基础", "入门", "画法", "步骤", "解析", "讲解", "思路分享", "干货", "保姆级", "新番", "自制剧", "连续剧", "小剧场", "剧情向", "大电影", "剧场版", "解说", "配音", "会限", "直播切片", "切片", "录播", "回放"]
# 同一个群两次点播的最小间隔（分钟）
min_gap_seconds = 60
# 每个群每天点播的次数上限（0 表示不限）；与搬史的额度分开记

# ── 没找到就继续找 ==========================================================
[retry]
# 一轮没找到符合条件的候选时，继续换关键词/翻页再找，最多试几轮
rounds = 3
# 两次尝试之间的间隔（秒），0 表示不等待
gap_seconds = 15
