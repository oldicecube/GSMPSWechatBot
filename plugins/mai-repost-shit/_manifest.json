{
  "manifest_version": 2,
  "id": "github.erhan111119.mai-repost-shit",
  "version": "1.3.0",
  "name": "B站搬史机（mai repost shit）",
  "description": "按群聊活跃度交由planner决定是否跟玩，或定时搬运B站抽象视频，以说明文字与MP4文件发送到微信",
  "author": {
    "name": "erhan111119",
    "url": "https://github.com/erhan111119"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/erhan111119/mai-repost-shit",
    "homepage": "https://github.com/erhan111119/mai-repost-shit",
    "documentation": "https://github.com/erhan111119/mai-repost-shit/blob/main/README.md",
    "issues": "https://github.com/erhan111119/mai-repost-shit/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27,<1.0"
    }
  ],
  "plugin_type": "media",
  "capabilities": [
    "send.text",
    "send.forward",
    "send.custom",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "maisaka.context.append",
    "maisaka.proactive.trigger",
    "config.get",
    "chat.get_all_streams",
    "message.get_recent",
    "send.hybrid",
    "api.call",
    "tool.get_definitions"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
