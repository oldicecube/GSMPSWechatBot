{
  "manifest_version": 2,
  "id": "mailife.mai-life",
  "version": "1.3.0",
  "name": "麦麦生活",
  "description": "自动生成每日日程与生活分享，统一管理当前聊天流的单次定时意图，注入跨天活动并在到期时唤醒规划器。",
  "author": {
    "name": "mailife",
    "url": "https://github.com/tsuiraku9"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/tsuiraku9/mai-life",
    "homepage": "https://github.com/tsuiraku9/mai-life",
    "documentation": "https://github.com/tsuiraku9/mai-life/blob/main/README.md",
    "issues": "https://github.com/tsuiraku9/mai-life/issues"
  },
  "host_application": {
    "min_version": "1.3.1",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.7.1",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "llm.generate",
    "chat.get_all_streams",
    "maisaka.proactive.trigger",
    "message.get_by_time_in_chat",
    "message.build_readable",
    "knowledge.search",
    "config.get",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
